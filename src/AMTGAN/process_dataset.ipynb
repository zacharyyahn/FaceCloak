    "import os\n",
    "import shutil\n",
    "from tqdm import tqdm\n",
    "\n",
    "old_path = \"assets/datasets/CelebA-HQ/\"\n",
    "new_path = \"../../data/celeba/gallery/\"\n",
    "\n",
    "for im in tqdm(os.listdir(old_path)):\n",
    "    name = im[:im.find(\".\")]\n",
    "    shutil.copy(old_path+im,new_path+name+\"_1.jpg\")"
   ]
  },
